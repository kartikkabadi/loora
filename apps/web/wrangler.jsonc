{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loora-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": true,
  "vars": {
    "REALTIME_WS_URL": "wss://ws.loora.design",
    "REALTIME_INGEST_URL": "https://ws.loora.design"
  },
  "routes": [
    {
      "pattern": "loora.design/*",
      "zone_name": "loora.design"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "loora",
      "preview_bucket_name": "loora-preview"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_AUTH_CREDENTIALS",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "2002",
      "simple": { "limit": 240, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_RPC",
      "namespace_id": "2003",
      "simple": { "limit": 900, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_RPC_ANONYMOUS",
      "namespace_id": "2004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_REALTIME_TICKET",
      "namespace_id": "2005",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_ASSET",
      "namespace_id": "2006",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_HANDOFF",
      "namespace_id": "2007",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_HANDOFF_ASSET",
      "namespace_id": "2008",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_PUBLISH",
      "namespace_id": "2009",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_PUBLISHED_SITE",
      "namespace_id": "2010",
      "simple": { "limit": 240, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_GITHUB",
      "namespace_id": "2011",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_CHATGPT",
      "namespace_id": "2012",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_ASSISTANT",
      "namespace_id": "2013",
      "simple": { "limit": 40, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_GITHUB_WEBHOOK",
      "namespace_id": "2014",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  }
}
