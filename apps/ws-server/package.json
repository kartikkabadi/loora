{
  "name": "@loora/ws-server",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev --port 4200",
    "test": "vitest run --config vitest.config.ts",
    "types": "wrangler types --env-interface Env --env-file .dev.vars.example --strict-vars false --include-runtime false"
  },
  "dependencies": {
    "@loora/realtime": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "^4.129.0",
    "@cloudflare/vitest-plugin": "^1.4.6"
  }
}
